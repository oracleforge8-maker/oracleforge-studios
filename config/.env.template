# ============================================================
# OracleForge Environment Configuration
# Copy this file to .env and fill in your REAL API keys.
# NEVER commit the real .env file to version control!
# ============================================================

# ------------------------------------------------------------
# AI / OpenRouter (REQUIRED for The Brain - DeepSeek Flash)
# Get key at: https://openrouter.ai/settings/keys
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model ID for DeepSeek Flash via OpenRouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Optional: alternate model if the primary is unavailable
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# ------------------------------------------------------------
# OpenAI / DALL-E 3 (REQUIRED for The Forge image generation)
# Get key at: https://platform.openai.com/api-keys
# If blank, The Forge falls back to branded SVG placeholder images.
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard

# ------------------------------------------------------------
# Twitter / X API (REQUIRED for autonomous posting)
# Get credentials at: https://developer.twitter.com/
# ------------------------------------------------------------
TWITTER_API_KEY=YOUR_TWITTER_API_KEY
TWITTER_API_SECRET=YOUR_TWITTER_API_SECRET
TWITTER_ACCESS_TOKEN=YOUR_TWITTER_ACCESS_TOKEN
TWITTER_ACCESS_SECRET=YOUR_TWITTER_ACCESS_SECRET
TWITTER_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN
TWITTER_BOT_HANDLE=chadsatosh0y
# Daily follow limit for growth strategy
TWITTER_DAILY_FOLLOW_LIMIT=70
# Keywords used to find accounts to follow
TWITTER_FOLLOW_KEYWORDS=memecoin,crypto,defi,altcoin,web3,bitcoin,ethereum,solana,doge,shiba

# ------------------------------------------------------------
# Discord (REQUIRED for Discord auto-posting)
# Create a bot at: https://discord.com/developers/applications
# Invite with Send Messages + Read Message History permissions.
# ------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ANNOUNCEMENTS=
# Channel IDs for auto-post targets (leave blank to skip)
DISCORD_CHANNEL_TREND_RADAR=
DISCORD_CHANNEL_ALPHA_CHAT=
DISCORD_CHANNEL_MEMES=
DISCORD_WELCOME_MESSAGE=Welcome to the OracleForge forge, anon! 🔥 We forge the memes. You ride the waves. 🚀

# ------------------------------------------------------------
# LinkedIn (REQUIRED for weekly B2B posts)
# Get credentials at: https://www.linkedin.com/developers/
# ------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# ------------------------------------------------------------
# Stripe (REQUIRED for paid tiers)
# Keys at: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_RADAR_PRO=price_xxxxx
STRIPE_PRICE_FORGE=price_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# ------------------------------------------------------------
# Site / App
# ------------------------------------------------------------
# Domain used in generated links (canonical). Use localhost for dev.
SITE_URL=http://localhost:5000
# Secret key for Flask sessions (change this to random string!)
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Production mode: development / production / test
FLASK_ENV=development
# Database file path (relative to project root default: data/chronicler.db)
DATABASE_PATH=data/chronicler.db
# Archive root directory (default: data/archive)
ARCHIVE_PATH=data/archive
# Log directory (default: logs)
LOG_PATH=logs

# ------------------------------------------------------------
# Patreon (patron membership tiers)
# Get credentials at: https://www.patreon.com/portal/registration
# Webhook secret: Patreon Dashboard -> Settings -> Integrations -> Webhooks
# ------------------------------------------------------------
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_ACCESS_TOKEN=
PATREON_REFRESH_TOKEN=
PATREON_WEBHOOK_SECRET=
# Optional custom tier names (defaults: Forge Supporter / Meme Master / Forge Master)
PATREON_TIER1_NAME=Forge Supporter
PATREON_TIER2_NAME=Meme Master
PATREON_TIER3_NAME=Forge Master

# ------------------------------------------------------------
# CoinGecko (OPTIONAL — homepage market ticker)
# Get a key at: https://www.coingecko.com/en/api
# If blank, the ticker falls back to built-in sample data (no live fetch).
# ------------------------------------------------------------
COINGECKO_API_KEY=

# ------------------------------------------------------------
# Referral Program
# ------------------------------------------------------------
# Number of referrals for permanent Pro access
REFERRALS_FOR_FREE_PRO=3
# Number of free users getting 1 month Pro for free
FIRST_N_WAITLIST_FREE_PRO=100

# ------------------------------------------------------------
# Observatory Dashboard (The Observatory)
# ------------------------------------------------------------
# Dashboard login credentials (CHANGE THESE!)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme-strong-password
# Port for the dashboard server (default 5001)
DASHBOARD_PORT=5001

# ------------------------------------------------------------
# Credential Vault (The Archive)
# ------------------------------------------------------------
# Encrypted vault + manifest file paths (relative to project root)
VAULT_PATH=data/vault/credentials.enc
MANIFEST_PATH=data/vault/manifest.enc

# ------------------------------------------------------------
# Backup API Keys (The Mechanic - key rotation)
# Set these to a second key per service so The Mechanic can
# rotate when the primary is rate-limited.
# ------------------------------------------------------------
OPENROUTER_BACKUP_KEY=
OPENAI_BACKUP_KEY=
TWITTER_BACKUP_KEY=
STRIPE_BACKUP_KEY=

# ------------------------------------------------------------
# Email Alerts (The Watchtower / Mechanic escalation)
# Optional SMTP for sending alert emails.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@oracleforge.ai
ALERT_EMAIL=

# ------------------------------------------------------------
# Affiliate Links (optional - "buy us an energy drink")
# ------------------------------------------------------------
AFFILIATE_COINBASE=https://www.coinbase.com/join/referral
AFFILIATE_BINANCE=https://www.binance.com/en/register?ref=referral
AFFILIATE_NAMECHEAP=https://www.namecheap.com/?aff=referral