[
  {
    "name": "OracleForge - Scout Cycle (every 4h)",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "hours",
                "hoursInterval": 4
              }
            ]
          }
        },
        "id": "trigger-scout-cycle",
        "name": "Every 4 Hours",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [0, 0]
      },
      {
        "parameters": {
          "command": "python main.py --run-scout",
          "cwd": "/data/oracleforge"
        },
        "id": "exec-scout",
        "name": "Run Scout",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [200, 0]
      },
      {
        "parameters": {
          "command": "python main.py --run-brain --mode analysis",
          "cwd": "/data/oracleforge"
        },
        "id": "exec-brain",
        "name": "Run Brain",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [400, 0]
      },
      {
        "parameters": {
          "command": "python main.py --run-chronicle --chronicle-mode archive",
          "cwd": "/data/oracleforge"
        },
        "id": "exec-chronicle",
        "name": "Run Chronicler",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [600, 0]
      }
    ],
    "connections": {
      "Every 4 Hours": {
        "main": [[{ "node": "Run Scout", "type": "main", "index": 0 }]]
      },
      "Run Scout": {
        "main": [[{ "node": "Run Brain", "type": "main", "index": 0 }]]
      },
      "Run Brain": {
        "main": [[{ "node": "Run Chronicler", "type": "main", "index": 0 }]]
      }
    },
    "settings": { "executionOrder": "v1" }
  },
  {
    "name": "OracleForge - Radar Posts (3x daily)",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              { "field": "hours", "hoursInterval": 1 },
              { "field": "triggerAtHour", "triggerAtHour": 9 },
              { "field": "triggerAtMinute", "triggerAtMinute": 0 }
            ]
          }
        },
        "id": "trigger-radar-1",
        "name": "09:00 UTC",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [0, 0]
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              { "field": "hours", "hoursInterval": 1 },
              { "field": "triggerAtHour", "triggerAtHour": 16 },
              { "field": "triggerAtMinute", "triggerAtMinute": 0 }
