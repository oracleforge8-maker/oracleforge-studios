          }
        },
        "id": "trigger-radar-2",
        "name": "16:00 UTC",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [0, 200]
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              { "field": "hours", "hoursInterval": 1 },
              { "field": "triggerAtHour", "triggerAtHour": 22 },
              { "field": "triggerAtMinute", "triggerAtMinute": 0 }
            ]
          }
        },
        "id": "trigger-radar-3",
        "name": "22:00 UTC",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [0, 400]
      },
      {
        "parameters": {
          "command": "python main.py --run-social --platform twitter --social-mode radar_posts --dry-run",
          "cwd": "/data/oracleforge"
        },
        "id": "exec-radar",
        "name": "Post Radar",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [200, 200]
      }
    ],
    "connections": {
      "09:00 UTC": { "main": [[{ "node": "Post Radar", "type": "main", "index": 0 }]] },
      "16:00 UTC": { "main": [[{ "node": "Post Radar", "type": "main", "index": 0 }]] },
      "22:00 UTC": { "main": [[{ "node": "Post Radar", "type": "main", "index": 0 }]] }
    },
    "settings": { "executionOrder": "v1" }
  },
