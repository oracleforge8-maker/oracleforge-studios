  {
    "name": "OracleForge - On-Demand Image (Webhook)",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "forge-image",
          "responseMode": "onReceived"
        },
        "id": "trigger-webhook",
        "name": "Webhook /forge-image",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1.2,
        "position": [0, 0],
        "webhookId": "oracleforge-forge-image"
      },
      {
        "parameters": {
          "command": "python main.py --run-forge --type brand",
          "cwd": "/data/oracleforge"
        },
        "id": "exec-forge",
        "name": "Generate Image",
